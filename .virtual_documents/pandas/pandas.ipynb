import pandas as pd
#AQI data set
df=pd.read_csv("globalAirQuality.csv")
df.describe()


#selecting data
df["city"]
#for rows
df.loc[2]
df.loc[0:2]
df.iloc[2]
df.iloc[0:2]
#for rows nd column
df.loc[0,["city","aqi"]]
df.columns
df.iloc[0,0:3]
#select single vector
df.at[0,"city"]
df.iat[0,2]


df


#filtering data
df[df["aqi"]>100]
df[(df["aqi"]>100)&(df["temperature"]>30)]
df[(df["aqi"]>100)&(df["temperature"]>30)][["city","aqi"]]
#diff between lable and index
aqi_data=df[(df["aqi"]>100)&(df["temperature"]>30)][["city","aqi"]]
aqi_data
aqi_data.iloc[0]
#aqi_data.loc[0] # will give error
#query
aqi_val=100
df.query("aqi>100 & temperature>30")[["city","aqi"]]
df.query("aqi>@aqi_val & temperature>30")[["city","aqi"]]


#cleaning data
df=pd.read_csv("raw_data.csv")
df.isnull()
df.isnull().sum(axis=1)#rows
df.isnull().sum()#columns
df.dropna()#columns
df.dropna(axis=1)#rows
df.fillna(0)
df.ffill()
df.bfill()
cleaned_data=df.copy()
age_mean=cleaned_data["age"].mean()
cleaned_data["age"]=cleaned_data["age"].fillna(age_mean)
cleaned_data



